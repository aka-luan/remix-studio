# One Google key runs everything (Nano Banana, Omni Flash video, analysis).
# Google AI Pro includes $10/month of Cloud credits that pay for it.
GEMINI_API_KEY=

# Optional: let Claude write the script instead of Gemini (PLANNER=claude)
PLANNER=gemini
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Optional model overrides
GEMINI_TEXT_MODEL=gemini-flash-latest
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash
